{
  "name": "@primajin/pass-a-way",
  "version": "0.1.0",
  "description": "A way to pass away a password before you pass away.",
  "license": "ISC",
  "repository": "github:Primajin/pass-a-way",
  "homepage": "https://github.com/Primajin/pass-a-way#readme",
  "bugs": "https://github.com/Primajin/pass-a-way/issues",
  "author": "Jannis Hell",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:browser & npm run build:server",
    "build:browser": "node scripts/build.js --minify",
    "build:server": "ncc build src/node/index.js -m -o dist/server",
    "coverage": "c8 --reporter=lcov --all --include 'src/**' ava",
    "dev:browser": "node scripts/build.js --watch --sourcemap",
    "dev:node": "npx nodemon src/node/index.js --ext js",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "lint:watch": "npx nodemon -x npm run lint:fix --ext js,json",
    "test": "ava",
    "test:watch": "ava --watch"
  },
  "keywords": [
    "cryptography",
    "passwords",
    "steganography",
    "death",
    "insurance",
    "afterlife"
  ],
  "dependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "xo": "^5.0.1"
  }
}
